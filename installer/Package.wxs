  <Fragment>
    <!-- Start-menu shortcut + the HKCU key that makes it a per-user component. -->
    <Component Id="cmp_Shortcut" Directory="AppMenuFolder" Guid="{E9ACDFBD-3CD5-52EC-971D-4895C6207C0D}">
      <Shortcut Id="StartMenuShortcut" Name="Filesa COChat"
                Description="局域网多人聊天 · 无需专用服务器"
                Target="[INSTALLFOLDER]FilesaCOChat.WinUI.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="rm_AppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
      <RemoveFolder Id="rm_InstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Filesa\COChat" Name="InstallDir"
                     Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>
  </Fragment>
